%% ximera-components.sty
%%
%% Loads the interactive pieces of Ximera: \answer, multipleChoice and
%% \choice, selectAll, wordChoice, freeResponse, hint, foldable, proof,
%% dialogue, verbatim, video, xkcd.
%%
%% Why this file exists.  In the npm version of Ximera each of these is a
%% package of its own (ximera-multiple-choice.sty and so on), installed by
%% the build, and the class does not load them.  Without them the commands
%% are undefined: LaTeX skips them, the build carries on, and a multiple
%% choice question comes out on the web page as plain text.
%%
%% Use: \usepackage{ximera-components} in the preamble (src/preamble.tex).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ximera-components}[2026/11/20 v1.0 Load the Ximera component packages]

%% For the web page the class copies every \newcommand made in the preamble
%% into the page, for MathJax.  That is meant for the author's own macros.
%% The component packages make many internal definitions (and reload font
%% commands such as \rm and \bf), which must not be copied: MathJax would
%% take them over its own.  Switch the copying off while they load.
\let\xmcomp@savedargdef\@argdef
\ifdefined\@oldargdef \let\@argdef\@oldargdef \fi

%% ximera-choice.sty and ximera-xkcd.sty name their own commands in their
%% version line before defining them.  Make those names harmless until then.
%% (Not when the package is already loaded: that would undo its definitions.)
\@ifpackageloaded{ximera-choice}{}%
  {\let\choice\relax \let\otherchoice\relax \let\inlinechoice\relax}
\@ifpackageloaded{ximera-xkcd}{}{\let\xkcd\relax}

\@for\xmcomp@pkg:=answer,multiple-choice,select-all,word-choice,%
free-response,hint,foldable,proof,dialogue,verbatim,video,xkcd\do{%
  \IfFileExists{ximera-\xmcomp@pkg.sty}%
    {\edef\xmcomp@tmp{\noexpand\RequirePackage{ximera-\xmcomp@pkg}}\xmcomp@tmp}%
    {\PackageWarningNoLine{ximera-components}%
       {ximera-\xmcomp@pkg.sty is not installed; skipped}}%
}

%% Words used on the web page by xm-a11y.4ht (accessibility of foldable,
%% expandable, accordion, hint, theorems and footnotes; applied through
%% ximera-components.4ht).  Change them with \renewcommand in the preamble,
%% after \usepackage{ximera-components}.
\newcommand{\xmaHintWord}{Hint}
\newcommand{\xmaFootnoteWord}{Footnote}
\newcommand{\xmaExpandableWord}{This is an expandable}
%% The name a screen reader gives the drop-down list of \wordChoice.
\newcommand{\xmaWordChoiceWord}{Choose the missing word}

%% Problem numbers in the PDF (problem, exercise, question, exploration).
%% The class works out a problem's number inside the label of a list item
%% (\item[Problem \problemNumber]), creating and stepping counters while the
%% label is being typeset. Two things go wrong:
%%   * a \label inside a problem got an older number (\stepcounter, not
%%     \refstepcounter), so \ref to the first problem said "2";
%%   * from TeX Live 2026 on, a \label right after \begin{problem} makes
%%     LaTeX expand the item's label, and creating a counter in the middle
%%     of that fails ("Missing \endcsname inserted"): no PDF at all.
%% Here the number is worked out before the item, the same way (1, 2, ...;
%% 1.1, 1.2 for a problem inside a problem), and registered for \label.
%% The web page does not use this code (latex/xm-a11y.4ht).
\ifdefined\problemEnvironmentStart
  \newcommand{\xmcomp@problemnumber}{%
    \ifcsname c@depth\Roman{problem@Depth}Count\endcsname\else
      \expandafter\newcounter{depth\Roman{problem@Depth}Count}%
    \fi
    \refstepcounter{depth\Roman{problem@Depth}Count}%
    \edef\xmcomp@probnum{\arabic{depthICount}}%
    \forloop{Iteration@probCnt}{2}{\arabic{Iteration@probCnt} < \numexpr \value{problem@Depth} + 1 \relax}{%
      \edef\xmcomp@probnum{\xmcomp@probnum.\arabic{depth\Roman{Iteration@probCnt}Count}}}%
    \let\@currentlabel\xmcomp@probnum}
  \renewcommand{\problemEnvironmentStart}[2]{%
    \stepcounter{problem@Depth}%
    \def\spaceatend{#1}%
    \xmcomp@problemnumber
    \begin{trivlist}%
    \item[\hskip\labelsep\sffamily\bfseries\GetTranslation{#2} \xmcomp@probnum]%
    \slshape}%
\fi

%% For latex/xm-links.4ht: on the web page, \label writes to the .aux file
%% what kind of thing it names (section, equation, ...), as \xmlk@type.
%% Defined here, for the PDF as well, because the .aux file is read before
%% the web page's own settings are.
\providecommand{\xmlk@type}[2]{\global\@namedef{xmlk@t@#1}{#2}}

\let\@argdef\xmcomp@savedargdef
\endinput
